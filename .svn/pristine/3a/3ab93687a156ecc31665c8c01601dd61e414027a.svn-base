{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "8f379604",
   "metadata": {},
   "outputs": [],
   "source": [
    "import random\n",
    "import numpy \n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "timestep = 10000\n",
    "equal_probability = numpy.zeros((timestep)) \n",
    "probability_propo = numpy.zeros((timestep))\n",
    "\n",
    "#degree 2  \n",
    "equal_probability[0] = 2 \n",
    "probability_propo[0] = 2\n",
    "\n",
    "for i in range (1,timestep):\n",
    "    equal_probability[i] = 1\n",
    "    probability_propo[i] = 1\n",
    "    \n",
    "    selected = random.randint(0, i-1)\n",
    "    equal_probability[selected] +=  1\n",
    "    \n",
    "    pro = numpy.add(probability_propo[0:i],0.00)\n",
    "    # print(pro)\n",
    "    pro = numpy.true_divide(pro,pro.sum())\n",
    "    #print(p)     \n",
    "    selected = numpy.random.choice(range(0,i), p = pro) \n",
    "    probability_propo[selected] += 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "49c328a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def entropy(value): \n",
    "    summation = value.sum()\n",
    "    result = 0\n",
    "    for i in value:\n",
    "        if(i>0): \n",
    "            probability = i/summation\n",
    "            result -= probability*numpy.log2(probability)\n",
    "    return result "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "fbdbc5fd",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "\n",
