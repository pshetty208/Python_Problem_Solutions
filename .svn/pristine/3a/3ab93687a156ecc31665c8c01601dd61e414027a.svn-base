     },
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Entropy with equal probability:  1.9964502747544117\n"
     ]
    }
   ],
   "source": [
    "equal_probability_plot = numpy.histogram(equal_probability, bins = range(1,int(max(equal_probability)))) \n",
    "equal_probability_data = equal_probability_plot[1][0:len(equal_probability_plot[0])]\n",
    "equal_probability_plot = equal_probability_plot[0]\n",
    "plt.loglog(equal_probability_data, equal_probability_plot)\n",
    "plt.title('Equal Probability')\n",
    "plt.xlabel('Degree') \n",
    "plt.ylabel('Count')\n",
    "plt.show()\n",
    "print(\"Entropy with equal probability: \", entropy(equal_probability_plot))"
   ]
  },
  {
